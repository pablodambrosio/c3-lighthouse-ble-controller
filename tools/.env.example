# S3 / Lightsail Bucket Credentials for PWA Deployment
S3_BUCKET=c3-lighthouse
AWS_ACCESS_KEY_ID=your-lightsail-bucket-access-key
AWS_SECRET_ACCESS_KEY=your-lightsail-bucket-secret-key
AWS_REGION=us-east-1

# Lightsail CDN Distribution & Management API keys (optional: used to purge cache automatically)
LIGHTSAIL_DISTRIBUTION_NAME=c3-lighthouse-distro
LIGHTSAIL_API_KEY_ID=your-iam-admin-access-key
LIGHTSAIL_API_SECRET_KEY=your-iam-admin-secret-key

# Optional settings
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC=false
